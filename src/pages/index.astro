---
import Base from '../layouts/Base.astro';
import {tools} from '../data/tools';
const categories=['All','Prayer','Ramadan','Zakat','Dates','Everyday'];
---
<Base title="Free Islamic Tools & Calculators" description="Free Islamic tools: prayer times, Qibla direction, Zakat calculator, Hijri date converter, Ramadan timetable and more. No sign-up needed.">
 <section id="tools" class="section directory" aria-labelledby="directory-heading">
  <p class="eyebrow">FREE TOOLS · NO SIGN-UP</p>
  <div class="directory-heading"><div><h1 id="directory-heading">Islamic tools for everyday life</h1><p>Find what you need and get straight to it. Fast, free calculators, trackers and timetables.</p></div><span class="directory-count">{tools.length} useful tools</span></div>
  <div class="tool-search"><label for="tool-search-input">Find a tool</label><input id="tool-search-input" type="search" placeholder="Search: zakat, prayer, Ramadan, Hijri…" autocomplete="off" /></div>
  <div class="filters" role="group" aria-label="Tool categories">{categories.map((name,i)=><button class:list={['filter',{'active':i===0}]} type="button" data-filter={name.toLowerCase()} aria-pressed={i===0}>{name}</button>)}</div>
  <p id="tool-count" class="small" aria-live="polite"></p>
  <div class="cards" id="tool-grid">{tools.map(tool=><a class="card" data-category={tool.category.toLowerCase()} data-search={`${tool.name} ${tool.desc} ${tool.keywords}`.toLowerCase()} href={`/tools/${tool.slug}/`}><span class="symbol" aria-hidden="true">{tool.icon}</span><span class="category">{tool.category}</span><h2>{tool.name}</h2><p>{tool.desc}</p><span class="arrow">Open tool →</span></a>)}</div>
  <p id="no-results" hidden>No matching tools. Try another search or select All.</p>
 </section>
 <section class="note"><h2>Designed to be useful, not complicated</h2><p>Most calculators work directly in your browser. For religious decisions, remember that prayer calculation settings, regional Hijri dates and Zakat guidance can differ. Each tool explains its assumptions.</p></section>
</Base>
<script>
 const search=document.querySelector<HTMLInputElement>('#tool-search-input');
 const cards=Array.from(document.querySelectorAll<HTMLElement>('#tool-grid .card'));
 const buttons=Array.from(document.querySelectorAll<HTMLButtonElement>('.filter'));
 const count=document.querySelector<HTMLElement>('#tool-count');
 const empty=document.querySelector<HTMLElement>('#no-results');
 let selected='all';
 function filter(){
  const query=search?.value.toLowerCase().trim()??'';
  let total=0;
  cards.forEach(card=>{const show=(selected==='all'||card.dataset.category===selected)&&(card.dataset.search??'').includes(query);card.hidden=!show;if(show)total++});
  if(count)count.textContent=total===1?'1 tool shown':`${total} tools shown`;
  if(empty)empty.hidden=total!==0;
 }
 buttons.forEach(button=>button.addEventListener('click',()=>{selected=button.dataset.filter??'all';buttons.forEach(b=>{const active=b===button;b.classList.toggle('active',active);b.setAttribute('aria-pressed',String(active))});filter()}));
 search?.addEventListener('input',filter);
 filter();
</script>