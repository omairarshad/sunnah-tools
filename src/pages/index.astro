---
import Base from '../layouts/Base.astro';
import UsefulLinks from '../components/UsefulLinks.astro';
import AdPlacement from '../components/AdPlacement.astro';
import {toneForSlug} from '../data/toolTones';
import {tools} from '../data/tools';
import {toolTopics,toolTopicBySlug} from '../data/toolTopics';
import homepage from '../data/homepage.json';
import {safePromoUrl,safePromoImage,safeToolImage,orderedSections,validTone} from '../lib/homepageConfig.mjs';
const categories=['All','Prayer','Ramadan','Zakat','Dates','Everyday'];
const bySlug=new Map(tools.map(tool=>[tool.slug,tool]));
const listed=new Set<string>();
const toolCards=homepage.directory.cards.flatMap(item=>{
 if(listed.has(item.slug)||!item.enabled)return [];
 const tool=bySlug.get(item.slug as typeof tools[number]['slug']);
 if(!tool)return [];
 listed.add(item.slug);
 return [{...tool,name:item.title||tool.name,desc:item.description||tool.desc,tone:validTone(item.tone),image:safeToolImage(item.image)??`/tool-art/${tool.slug}.svg`,imageAlt:item.imageAlt||`${tool.name} illustration`}];
});
const visibleTools=[...toolCards,...tools.filter(t=>!homepage.directory.cards.some(o=>o.slug===t.slug)).map(t=>({...t,tone:toneForSlug(t.slug),image:`/tool-art/${t.slug}.svg`,imageAlt:`${t.name} illustration`}))];
const topicName=new Map<string,{label:string;description:string}>(toolTopics.map(t=>[t.id,t] as [string,{label:string;description:string}]));
const order=orderedSections(homepage.layout.sectionOrder);
const rank=(section:string)=>order.indexOf(section);
const promos=homepage.promotions.cards.filter(c=>c.enabled&&safePromoUrl(c.url)).map(c=>({...c,tone:validTone(c.tone),externalUrl:safePromoUrl(c.url)!,imageSrc:safePromoImage(c.image)})).filter(c=>Boolean(c.imageSrc));
const categoryCounts=Object.fromEntries(categories.map(category=>[category,category==='All'?visibleTools.length:visibleTools.filter(x=>x.category===category).length]));
---
<Base title="Free Islamic Tools & Calculators" description="Prayer times, Qibla direction, Zakat calculator, Hijri converter and Ramadan timetables. Explore Islamic calculators, calendars and trackers.">
 {homepage.intro.enabled&&<section class="home-top" aria-label="Introduction">
  <div class="home-intro">
   <div class="home-intro-text">
    {homepage.intro.eyebrow&&<div class="eyebrow"><span class="eyebrow-line"></span> {homepage.intro.eyebrow}</div>}
    <h1>{homepage.intro.headline}{homepage.intro.emphasis&&<> <em>{homepage.intro.emphasis}</em></>}</h1>
    <p>{homepage.intro.description}</p>
   </div>
   <div class="intro-index" aria-label="Available tools"><strong>{visibleTools.length}</strong><small>Free Islamic tools</small></div>
  </div>
 </section>}
 <div class="home-layout">
 {homepage.promotions.enabled&&promos.length>0&&<section class="promo-section section" style={`order:${rank("promotions")}`} aria-labelledby="promo-heading">
  <div class="promo-heading"><div><h2 id="promo-heading">{homepage.promotions.title}</h2>{homepage.promotions.subtitle&&<p>{homepage.promotions.subtitle}</p>}</div></div>
  <div class="promo-grid">{promos.map(card=><a class:list={["promo-banner",{"promo-banner-featured":card.featured}]} data-tone={card.tone} data-promo-id={card.id} href={card.externalUrl} target="_blank" rel="noopener noreferrer" aria-label={`${card.title}: ${card.description}. ${card.cta} (opens in a new tab)`}>
   <img class="promo-banner-image" src={card.imageSrc} alt={card.imageAlt} width={card.featured?1400:750} height="560" loading={card.featured?"eager":"lazy"} decoding="async"/>
   
   <span class="promo-banner-bottom"><span class="promo-banner-cta">{card.cta}<span aria-hidden="true">↗</span></span></span>
   <span class="sr-only">{card.title}. {card.description}</span>
  </a>)}</div>
 </section>}
 <section id="tools" class="section directory" data-columns={homepage.directory.columns} style={`order:${rank("directory")}`} aria-labelledby="directory-heading">
  <div class="directory-heading">
   <div><h2 id="directory-heading">{homepage.directory.title}</h2><p class="small"><a href="/prayer-times/">Prayer times by city</a></p>{homepage.directory.description&&<p>{homepage.directory.description}</p>}</div>
  </div>
  <div class="directory-controls">
   <div class="tool-search"><label class="sr-only" for="tool-search-input">Search Islamic tools</label><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg><input id="tool-search-input" type="search" placeholder="Search tools, e.g. Zakat, Qibla, Ramadan..." autocomplete="off"/><kbd class="search-shortcut" aria-hidden="true">/</kbd></div>
   <div class="filters" role="group" aria-label="Filter Islamic tools by category">
    {categories.map((category,index)=><button class:list={['filter',{active:index===0}]} type="button" data-filter={category.toLowerCase()} aria-pressed={index===0}>{category}<span class="filter-count">{categoryCounts[category]}</span></button>)}
   </div>
  </div>
  <section id="recent-section" class="recent-tools" hidden aria-labelledby="recent-heading"><div class="section-label"><h3 id="recent-heading">Recently opened</h3></div><div id="recent-links" class="recent-links"></div></section>
  <div class="directory-list-heading"><p id="tool-count" class="small" aria-live="polite">{visibleTools.length} tools</p></div>
  <div class="cards" id="tool-grid">
   {visibleTools.map((tool,index)=><Fragment>
    {(index===0||toolTopicBySlug[visibleTools[index-1]?.slug]!==toolTopicBySlug[tool.slug])&&
     <div class="directory-topic-heading" data-topic-heading={toolTopicBySlug[tool.slug]}><h3>{topicName.get(toolTopicBySlug[tool.slug])?.label}</h3></div>}
    <article class="tool-card" data-topic={toolTopicBySlug[tool.slug]} data-tone={tool.tone} data-slug={tool.slug} data-category={tool.category.toLowerCase()} data-search={`${tool.name} ${tool.desc} ${tool.keywords}`.toLowerCase()}>
    <a class="tool-card-main" href={`/tools/${tool.slug}/`} aria-label={`Open ${tool.name}`}>
     <span class="tool-card-visual"><img src={tool.image} alt={tool.imageAlt} width="600" height="360" loading="lazy" decoding="async"/></span>
     <span class="tool-card-body">
      <h3>{tool.name}</h3>
      <span class="tool-card-description">{tool.desc}</span>
     </span>
    </a>
   </article></Fragment>)}
  </div>
  <div id="no-results" class="no-results" hidden><strong>We couldn't find a matching tool.</strong><p>Try a different keyword or clear your category filter.</p><button id="clear-filters" class="button-outline" type="button">Show all tools</button></div>
  <AdPlacement placement="home"/>
 </section>
 {homepage.layout.showGuides&&<section class="home-guides section" style={`order:${rank("guides")}`} aria-labelledby="learning-heading">
 <div class="section-label"><h2 id="learning-heading">Guides</h2></div>
 <div class="guide-links">
  <a href="/guides/prayer-time-methods/"><strong>How are prayer times calculated?</strong><span>Fajr, Isha, Asr, high latitudes and local mosque differences →</span></a>
  <a href="/guides/ramadan-dates-and-timetables/"><strong>Plan a reliable Ramadan timetable</strong><span>Understand lunar dates, suhoor cutoffs and printable fasting times →</span></a>
  <a href="/guides/hijri-calendar-and-moon-sighting/"><strong>How does the Hijri calendar work?</strong><span>Umm al-Qura, moon sighting and Islamic date differences →</span></a>
  <a href="/guides/zakat-nisab-and-fitrana/"><strong>Understanding Zakat and Nisab</strong><span>Wealth thresholds, asset calculations and Fitrana rates →</span></a>
  <a href="/guides/using-islamic-planning-tools/"><strong>Use checklists and planners wisely</strong><span>Daily progress, local storage and printing guidance →</span></a>
 </div>
 </section>}
 </div>
 <UsefulLinks/>
</Base>
<script>
 const search=document.querySelector<HTMLInputElement>('#tool-search-input');
 const cards=Array.from(document.querySelectorAll<HTMLElement>('#tool-grid .tool-card'));
 const buttons=Array.from(document.querySelectorAll<HTMLButtonElement>('.filter'));
 const topicHeadings=Array.from(document.querySelectorAll<HTMLElement>('[data-topic-heading]'));
 const count=document.querySelector<HTMLElement>('#tool-count');
 const empty=document.querySelector<HTMLElement>('#no-results');
 const recent=document.querySelector<HTMLElement>('#recent-section');
 const recentLinks=document.querySelector<HTMLElement>('#recent-links');
 const clear=document.querySelector<HTMLButtonElement>('#clear-filters');
 const recentKey='sunnah-recent-tools-v1';
 const safeRead=(key:string):string[]=>{try{const a=JSON.parse(localStorage.getItem(key)??'[]');return Array.isArray(a)?a.filter((s:unknown)=>typeof s==='string') as string[]:[]}catch{return []}};
 const safeWrite=(key:string,value:string[])=>{try{localStorage.setItem(key,JSON.stringify(value))}catch{}};
 let selected='all';
 function filter(){
  const query=search?.value.trim().toLowerCase()??'';
  let total=0;
  cards.forEach(card=>{const matched=(selected==='all'||card.dataset.category===selected)&&(card.dataset.search??'').includes(query);card.hidden=!matched;if(matched)total++});
  topicHeadings.forEach(heading=>{heading.hidden=!cards.some(card=>!card.hidden&&card.dataset.topic===heading.dataset.topicHeading)});
  if(count)count.textContent=total===1?'1 tool':`${total} tools`;
  if(empty)empty.hidden=total>0;
 }
 function choose(category:string){selected=category;buttons.forEach(button=>{const isActive=button.dataset.filter===category;button.classList.toggle('active',isActive);button.setAttribute('aria-pressed',String(isActive))});filter()}
 buttons.forEach(button=>button.addEventListener('click',()=>choose(button.dataset.filter??'all')));
 search?.addEventListener('input',filter);
 clear?.addEventListener('click',()=>{if(search)search.value='';choose('all');search?.focus()});
 document.addEventListener('keydown',event=>{const el=document.activeElement;if((event.key==='/'&&!event.metaKey&&!event.ctrlKey&&!event.altKey&&!['INPUT','TEXTAREA','SELECT'].includes(el?.tagName??''))||((event.ctrlKey||event.metaKey)&&event.key.toLowerCase()==='k')){event.preventDefault();search?.focus();search?.scrollIntoView({block:'nearest',behavior:'smooth'})}if(event.key==='Escape'&&el===search){search?.blur()}});
 document.querySelectorAll<HTMLAnchorElement>('.tool-card-main').forEach(link=>link.addEventListener('click',()=>{const slug=link.href.match(/\/tools\/([^/]+)\//)?.[1];if(slug)safeWrite(recentKey,[slug,...safeRead(recentKey).filter(x=>x!==slug)].slice(0,4))}));
 const recents=safeRead(recentKey).filter(slug=>cards.some(c=>c.dataset.slug===slug)).slice(0,4);
 if(recent&&recentLinks&&recents.length){recent.hidden=false;for(const slug of recents){const card=cards.find(c=>c.dataset.slug===slug);const a=document.createElement('a');a.href='/tools/'+slug+'/';a.textContent=card?.querySelector('h3')?.textContent??slug;recentLinks.appendChild(a)}}
 filter();
</script>