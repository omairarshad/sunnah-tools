---
import Base from '../../layouts/Base.astro';
import NewSunnahGuide from '../../components/NewSunnahGuide.astro';
import '../../styles/tool-accordion.css';
import AdPlacement from '../../components/AdPlacement.astro';
import ToolApp from '../../components/ToolApp';
import TahajjudGuide from '../../components/TahajjudGuide.astro';
import PrayerTimesGuide from '../../components/PrayerTimesGuide.astro';
import QiblaGuide from '../../components/QiblaGuide.astro';
import ZakatGuide from '../../components/ZakatGuide.astro';
import FastingTimesGuide from '../../components/FastingTimesGuide.astro';
import HijriConverterGuide from '../../components/HijriConverterGuide.astro';
import QuranPlannerGuide from '../../components/QuranPlannerGuide.astro';
import RamadanTimetableGuide from '../../components/RamadanTimetableGuide.astro';
import RamadanCountdownGuide from '../../components/RamadanCountdownGuide.astro';
import LaylatulQadrGuide from '../../components/LaylatulQadrGuide.astro';
import WhiteDaysGuide from '../../components/WhiteDaysGuide.astro';
import FastingTrackerGuide from '../../components/FastingTrackerGuide.astro';
import FidyaGuide from '../../components/FidyaGuide.astro';
import KaffarahGuide from '../../components/KaffarahGuide.astro';
import FitranaDeepGuide from '../../components/FitranaDeepGuide.astro';
import GoldZakatDeepGuide from '../../components/GoldZakatDeepGuide.astro';
import NisabDeepGuide from '../../components/NisabDeepGuide.astro';
import HawlDeepGuide from '../../components/HawlDeepGuide.astro';
import InvestmentZakatDeepGuide from '../../components/InvestmentZakatDeepGuide.astro';
import QurbaniDeepGuide from '../../components/QurbaniDeepGuide.astro';
import PrayerWidgetDeepGuide from '../../components/PrayerWidgetDeepGuide.astro';
import PrayerChartDeepGuide from '../../components/PrayerChartDeepGuide.astro';
import SalahTrackerDeepGuide from '../../components/SalahTrackerDeepGuide.astro';
import QadaPrayerDeepGuide from '../../components/QadaPrayerDeepGuide.astro';
import PrayerRakatsDeepGuide from '../../components/PrayerRakatsDeepGuide.astro';
import QuranJuzDeepGuide from '../../components/QuranJuzDeepGuide.astro';
import HifzDeepGuide from '../../components/HifzDeepGuide.astro';
import DailyAdhkarDeepGuide from '../../components/DailyAdhkarDeepGuide.astro';
import TasbihDeepGuide from '../../components/TasbihDeepGuide.astro';
import IslamicAgeDeepGuide from '../../components/IslamicAgeDeepGuide.astro';
import TravelPrayerDeepGuide from '../../components/TravelPrayerDeepGuide.astro';
import IslamicEventsDeepGuide from '../../components/IslamicEventsDeepGuide.astro';
import PrintableHijriDeepGuide from '../../components/PrintableHijriDeepGuide.astro';
import DhulHijjahDeepGuide from '../../components/DhulHijjahDeepGuide.astro';
import HalalAdditivesDeepGuide from '../../components/HalalAdditivesDeepGuide.astro';
import UmrahPackingDeepGuide from '../../components/UmrahPackingDeepGuide.astro';
import TawafSaiDeepGuide from '../../components/TawafSaiDeepGuide.astro';
import ToolIcon from '../../components/ToolIcon.astro';
import {toneForSlug} from '../../data/toolTones';
import {tools,toolBySlug} from '../../data/tools';
import {guides} from '../../data/guides';
import {toolSeo} from '../../data/toolSeo';
import {toolInsights} from '../../data/toolInsights';
import {toolTopicBySlug} from '../../data/toolTopics';
export function getStaticPaths(){return tools.map(tool=>({params:{slug:tool.slug}}))}
const slug=Astro.params.slug as keyof typeof toolBySlug;
const tool=toolBySlug[slug];
const guide=guides[slug];
const seo=toolSeo[slug];
const insight=toolInsights[slug];
if(!insight)throw new Error(`Missing example for ${slug}`);
if(!seo)throw new Error(`Missing unique SEO entry for ${slug}`);
const faqItems=[{question:guide.question,answer:guide.answer},...seo.faqs];
const faqSchema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqItems.map(item=>({'@type':'Question',name:item.question,acceptedAnswer:{'@type':'Answer',text:item.answer}}))};
// Editorial references are visible in the corresponding server-rendered guides.
const editorialSources:Record<string,{topic:string;citations:string[]}>= {
 'hijama-date-planner':{topic:"Hijama Date Planner",citations:["https://sunnah.com/abudawud:3861","https://www.nccih.nih.gov/health/cupping"]},
 'duha-prayer-time':{topic:"Duha Prayer Time Calculator",citations:["https://sunnah.com/muslim:720a"]},
 'istikhara-guide':{topic:"Istikhara Prayer Guide",citations:["https://sunnah.com/bukhari:1166"]},
 'friday-sunnah-checklist':{topic:"Friday Sunnah Checklist",citations:["https://sunnah.com/muslim:846a","https://quran.com/18"]},
 'islamic-will-planner':{topic:"Islamic Will Planner",citations:["https://quran.com/4/11","https://www.gov.uk/make-will"]},
 'aqiqah-planner':{topic:"Aqiqah Planner",citations:["https://sunnah.com/abudawud:2838"]},
 'sunnah-fasting-planner':{topic:"Sunnah Fasting Planner",citations:["https://sunnah.com/abudawud:2436","https://sunnah.com/abudawud:2449"]},
 'ramadan-countdown':{topic:'Ramadan start date and sunset countdown',citations:['https://quran.com/2/185','https://quran.com/2/187','https://sunnah.com/bukhari:1909','https://github.com/batoulapps/adhan-js']},
 'laylatul-qadr-nights':{topic:'Laylatul Qadr and the final ten nights of Ramadan',citations:['https://quran.com/97','https://sunnah.com/bukhari:2017','https://sunnah.com/bukhari:2021','https://sunnah.com/tirmidhi:3513']},
 'white-days-calendar':{topic:'Ayyam al-Bid White Days fasting calendar',citations:['https://sunnah.com/abudawud:2449','https://sunnah.com/muslim:1160','https://sunnah.com/muslim:1141a','https://quran.com/2/185']},
 'fasting-tracker':{topic:'Qada make-up fasting and personal fasting records',citations:['https://quran.com/2/184','https://quran.com/2/185','https://sunnah.com/bukhari:1950']},
 'fidya-calculator':{topic:'Fidya and eligible fasting compensation',citations:['https://quran.com/2/184','https://quran.com/2/185','https://sunnah.com/bukhari:4505']},
 'kaffarah-calculator':{topic:'Kaffarah for deliberate oaths and certain Ramadan cases',citations:['https://quran.com/5/89','https://sunnah.com/bukhari:1936','https://quran.com/2/185']},
 'fitrana-calculator':{topic:'Zakat al-Fitr household calculation and Eid timing',citations:['https://sunnah.com/bukhari:1503','https://sunnah.com/abudawud:1609','https://www.islamic-relief.org.uk/giving/islamic-giving/ramadan/zakat-al-fitr/']},
 'gold-zakat-calculator':{topic:'Gold Zakat jewellery purity and wealth assessment',citations:['https://quran.com/9/34','https://sunnah.com/bukhari:1405','https://www.islamic-relief.org.uk/giving/islamic-giving/zakat/zakat-on-jewellery/']},
 'nisab-calculator':{topic:'Gold and silver Nisab thresholds for Zakat',citations:['https://sunnah.com/bukhari:1405','https://www.islamic-relief.org.uk/giving/islamic-giving/zakat/nisab/']},
 'zakat-anniversary-calculator':{topic:'Hawl and annual Zakat review dates',citations:['https://sunnah.com/abudawud:1573','https://www.islamic-relief.org.uk/giving/islamic-giving/zakat/hawl/','https://www.islamic-relief.org.uk/giving/islamic-giving/zakat/when-to-pay-zakat/']},
 'zakat-stocks-crypto':{topic:'Zakat on trading stocks, long-term shares and crypto',citations:['https://quran.com/9/60','https://www.islamic-relief.org.uk/giving/islamic-giving/zakat/zakat-and-investment/','https://www.islamic-relief.org.uk/giving/islamic-giving/zakat/zakat-and-cryptocurrency/']},
 'qurbani-share-calculator':{topic:'Udhiyah sacrificial animal shares and cost planning',citations:['https://sunnah.com/muslim:1318a','https://quran.com/22/36','https://www.islamic-relief.org.uk/giving/islamic-giving/qurbani/qurbani-animals/']},
 'prayer-times-widget':{topic:'Embeddable calculated prayer times and timezone configuration',citations:['https://quran.com/4/103','https://sunnah.com/bukhari:631','https://github.com/batoulapps/adhan-js']},
 'printable-prayer-chart':{topic:'Printable five-prayer daily checklist',citations:['https://quran.com/4/103','https://sunnah.com/bukhari:631']},
 'salah-tracker':{topic:'Private daily five-prayer Salah recordkeeping',citations:['https://quran.com/4/103','https://sunnah.com/bukhari:631','https://sunnah.com/muslim:684a']},
 'qada-prayer-calculator':{topic:'Making up missed prayers and differences among Sunni legal schools',citations:['https://sunnah.com/muslim:684a','https://quran.com/4/103','https://seekersguidance.org/answers/living-religion/do-pass-missed-prayers-have-to-be-made-up/']},
 'prayer-rakats-chart':{topic:'Fard rakats and Sunnah Rawatib reference',citations:['https://sunnah.com/muslim:728c','https://sunnah.com/bukhari:631','https://quran.com/4/101']},
 'quran-juz-finder':{topic:'All thirty Quran Juz and their verse boundaries',citations:['https://quran.com/73/4','https://sunnah.com/bukhari:5027','https://quran.com/78/1']},
 'hifz-tracker':{topic:'Quran memorisation and revision planning',citations:['https://sunnah.com/bukhari:5027','https://sunnah.com/bukhari:5033','https://quran.com/73/4']},
 'daily-adhkar':{topic:'Quranic supplications and authentic Sunnah remembrance references',citations:['https://quran.com/13/28','https://quran.com/20/114','https://sunnah.com/abudawud:5082','https://sunnah.com/muslim:597a']},
 'tasbih-counter':{topic:'Post-prayer Dhikr counting patterns and their sources',citations:['https://quran.com/33/41','https://sunnah.com/muslim:596a','https://sunnah.com/muslim:597a']},
 'islamic-age':{topic:'Gregorian and Islamic lunar age, anniversaries and sunset boundaries',citations:['https://quran.com/9/36','https://quran.com/2/189','https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Intl/DateTimeFormat']},
 'travel-prayer-guide':{topic:'Qasr and Jam in travel across Sunni legal schools',citations:['https://quran.com/4/101','https://sunnah.com/bukhari:1081']},
 'islamic-events-calendar':{topic:'Lunar observance dates, Ramadan, Eid and Hajj',citations:['https://quran.com/2/189','https://quran.com/9/36','https://sunnah.com/bukhari:1909']},
 'printable-hijri-calendar':{topic:'Islamic lunar-month and Gregorian printed calendar',citations:['https://quran.com/2/189','https://sunnah.com/abudawud:2449']},
 'dhul-hijjah-planner':{topic:'First ten Dhul Hijjah, Arafah, Eid and Tashreeq',citations:['https://sunnah.com/bukhari:969','https://quran.com/89/1-2','https://sunnah.com/muslim:1141a']},
 'halal-additives-checker':{topic:'UK food additive E-numbers and source verification',citations:['https://www.gov.uk/government/publications/approved-additives-and-e-numbers/approved-additives-and-e-numbers','https://www.food.gov.uk/safety-hygiene/food-additives']},
 'umrah-packing-checklist':{topic:'Umrah and Hajj packing preparations and official travel requirements',citations:['https://umrah.nusuk.sa/','https://www.gov.uk/foreign-travel-advice/saudi-arabia','https://quran.com/2/158']},
 'tawaf-sai-counter':{topic:'Tawaf seven circuits and Sai Safa to Marwah lengths',citations:['https://quran.com/2/158','https://sunnah.com/muslim:1218a']}
};
const editorial=editorialSources[slug];
const articleSchema=editorial?{'@context':'https://schema.org','@type':'Article',headline:seo.h1,description:seo.description,mainEntityOfPage:`https://sunnah.tools/tools/${slug}/`,author:{'@type':'Organization',name:'Sunnah Tools',url:'https://sunnah.tools/'},publisher:{'@type':'Organization',name:'Sunnah Tools',url:'https://sunnah.tools/'},about:editorial.topic,citation:editorial.citations,inLanguage:'en',isAccessibleForFree:true}:null;
// Static hosting: publish a labelled UTC snapshot in HTML; the browser refreshes the local civil date.
const renderedAt=new Date();
const renderedDate=renderedAt.toISOString().slice(0,10);
const renderedHijriRaw=new Intl.DateTimeFormat('en-GB-u-ca-islamic-umalqura',{timeZone:'UTC',day:'numeric',month:'long',year:'numeric'}).format(renderedAt);
const renderedHijri=/\bAH\b/i.test(renderedHijriRaw)?renderedHijriRaw:renderedHijriRaw+' AH';
const enrichedDescription=seo.description;
const guideLinks:Record<string,{url:string;label:string}>={
 prayer:{url:'/guides/prayer-time-methods/',label:'How are prayer times calculated?'},
 ramadan:{url:'/guides/ramadan-dates-and-timetables/',label:'Ramadan dates and reliable fasting timetables'},
 dates:{url:'/guides/hijri-calendar-and-moon-sighting/',label:'Hijri calendars and local moon sighting'},
 zakat:{url:'/guides/zakat-nisab-and-fitrana/',label:'How Zakat, Nisab and Fitrana differ'},
 everyday:{url:'/guides/using-islamic-planning-tools/',label:'Making the most of Islamic planning tools'}
};
const guidePriorities:Record<string,string[]>={
 'hijri-converter':['dates','ramadan'],
 'white-days-calendar':['dates','ramadan'],
 'islamic-events-calendar':['dates','ramadan'],
 'printable-hijri-calendar':['dates','ramadan'],
 'ramadan-countdown':['ramadan','dates'],
 'prayer-times':['prayer','ramadan'],
 'fasting-times':['ramadan','prayer'],
 'ramadan-timetable':['ramadan','prayer'],
 'zakat-calculator':['zakat'],
 'fitrana-calculator':['zakat','ramadan'],
 'gold-zakat-calculator':['zakat'],
 'nisab-calculator':['zakat'],
 'laylatul-qadr-nights':['ramadan','dates'],
 'fidya-calculator':['zakat','ramadan'],
 'qada-prayer-calculator':['prayer','everyday'],
 'prayer-times-widget':['prayer'],
 'printable-prayer-chart':['prayer'],
 'salah-tracker':['prayer','everyday'],
 'prayer-rakats-chart':['prayer'],
 'quran-juz-finder':['quran'],
 'hifz-tracker':['quran'],
 'daily-adhkar':['quran','everyday'],
 'tasbih-counter':['everyday'],
 'islamic-age':['dates'],
 'qurbani-share-calculator':['everyday','zakat'],
 'zakat-anniversary-calculator':['zakat','dates'],
 'zakat-stocks-crypto':['zakat'],
 'kaffarah-calculator':['zakat','ramadan'],
 'tawaf-sai-counter':['everyday'],
 'travel-prayer-guide':['prayer'],
 'dhul-hijjah-planner':['dates'],
 'halal-additives-checker':['everyday'],
 'umrah-packing-checklist':['everyday']
};
const relatedGuides=[...new Set(guidePriorities[slug]??[toolTopicBySlug[slug]])].map(key=>guideLinks[key]).filter(Boolean);
const relatedPriority:Record<string,string[]>={
 'prayer-times':['qibla-finder','tahajjud-time','prayer-times-widget','fasting-times'],
 'qibla-finder':['prayer-times','tahajjud-time','hijri-converter','prayer-times-widget'],
 'hijri-converter':['islamic-events-calendar','printable-hijri-calendar','ramadan-countdown','white-days-calendar'],
 'tahajjud-time':['prayer-times','qibla-finder','printable-prayer-chart','prayer-times-widget'],
 'fasting-times':['ramadan-timetable','prayer-times','ramadan-countdown','white-days-calendar'],
 'ramadan-timetable':['fasting-times','laylatul-qadr-nights','ramadan-countdown','white-days-calendar'],
 'ramadan-countdown':['laylatul-qadr-nights','ramadan-timetable','fasting-times','islamic-events-calendar'],
 'white-days-calendar':['hijri-converter','islamic-events-calendar','printable-hijri-calendar','fasting-tracker'],
 'zakat-calculator':['gold-zakat-calculator','nisab-calculator','fitrana-calculator','hijri-converter'],
 'fitrana-calculator':['fidya-calculator','kaffarah-calculator','zakat-calculator','ramadan-timetable'],
 'gold-zakat-calculator':['zakat-calculator','nisab-calculator','fitrana-calculator','hijri-converter'],
 'islamic-events-calendar':['hijri-converter','printable-hijri-calendar','white-days-calendar','ramadan-countdown'],
 'printable-hijri-calendar':['hijri-converter','islamic-events-calendar','white-days-calendar','islamic-age'],
 'laylatul-qadr-nights':['ramadan-timetable','ramadan-countdown','fasting-times','white-days-calendar'],
 'fasting-tracker':['fasting-times','ramadan-timetable','fidya-calculator','white-days-calendar'],
 'fidya-calculator':['kaffarah-calculator','fitrana-calculator','fasting-tracker','zakat-calculator'],
 'qada-prayer-calculator':['salah-tracker','printable-prayer-chart','prayer-times','tahajjud-time'],
 'qurbani-share-calculator':['umrah-packing-checklist','nisab-calculator','islamic-events-calendar','zakat-calculator'],
 'kaffarah-calculator':['fidya-calculator','fasting-tracker','fitrana-calculator','ramadan-timetable'],
 'tawaf-sai-counter':['umrah-packing-checklist','qibla-finder','prayer-times','tasbih-counter'],
 'salah-tracker':['qada-prayer-calculator','printable-prayer-chart','prayer-times','tahajjud-time'],
 'umrah-packing-checklist':['tawaf-sai-counter','qurbani-share-calculator','qibla-finder','prayer-times']
};
const relatedFallback=tools.filter(x=>x.slug!==slug).sort((a,b)=>Number(toolTopicBySlug[b.slug]===toolTopicBySlug[slug])-Number(toolTopicBySlug[a.slug]===toolTopicBySlug[slug])||Number(b.category===tool.category)-Number(a.category===tool.category)).map(x=>x.slug);
const related=[...new Set([...(relatedPriority[slug]??[]),...relatedFallback])].filter(other=>other!==slug).slice(0,4).map(other=>toolBySlug[other as keyof typeof toolBySlug]);
const breadcrumb={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'All Islamic tools',item:'https://sunnah.tools/'},{'@type':'ListItem',position:2,name:tool.name,item:`https://sunnah.tools/tools/${slug}/`}]};
---
<Base title={seo.title} description={enrichedDescription}>
<script type="application/ld+json" set:html={JSON.stringify(breadcrumb)}/>
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)}/>
{articleSchema&&<script type="application/ld+json" set:html={JSON.stringify(articleSchema)}/>}
<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'WebApplication',name:seo.title,description:enrichedDescription,url:`https://sunnah.tools/tools/${slug}/`,applicationCategory:'UtilitiesApplication',operatingSystem:'Web browser',offers:{'@type':'Offer',price:'0',priceCurrency:'GBP'}})}/>
<section class="tool-screen" data-tone={toneForSlug(slug)}>
 <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/#tools">All tools</a><span aria-hidden="true">›</span><span>{tool.category}</span><span aria-hidden="true">›</span><span aria-current="page">{tool.name}</span></nav>
 <div class="tool-topline">
  <div class="tool-titles">
   <div class="tool-heading-identity"><span class="tool-heading-icon"><ToolIcon slug={slug} size={30}/></span></div>
   <h1>{seo.h1}</h1><p class="tool-lead">{guide.intro}</p>
  </div>
  <div class="tool-actions">
   <button id="share-current-tool" type="button" class="tool-action" aria-label="Share or copy this tool's link"><span aria-hidden="true">↗</span> Share</button>
  </div>
 </div>
 <div class="tool-layout">
  <div class="tool-main">
   {slug==='fasting-times'&&<nav class="fasting-guide-nav" aria-label="Suhoor and Iftar quick links">
    <a href="#fasting-calculator">Check today's times</a>
    <a href="#fasting-imsak">Fajr &amp; imsak</a>
    <a href="#fasting-duas">Duas &amp; Sunnah</a>
    <a href="#fasting-methods">UK summer times</a>
   </nav>}
   {slug==='hijri-converter'&&<nav class="hijri-guide-nav hijri-shortcuts" aria-label="Hijri converter quick links">
    <a href="#hijri-calculator">Convert a date</a>
    <a href="#hijri-calendars">Compare calendar methods</a>
    <a href="#hijri-sunset">Sunset boundary</a>
    <a href="#hijri-months">Twelve months</a>
   </nav>}
   {slug==='quran-planner'&&<nav class="quran-guide-nav quran-shortcuts" aria-label="Quran Planner quick links">
    <a href="#quran-calculator">Build a plan</a>
    <a href="#quran-how-to">How to plan</a>
    <a href="#quran-example">Worked example</a>
    <a href="#quran-catchup">Catch up</a>
   </nav>}
   {slug==='ramadan-timetable'&&<nav class="ramadan-guide-nav ramadan-shortcuts" aria-label="Ramadan Timetable quick links">
    <a href="#ramadan-calendar">Create timetable</a>
    <a href="#ramadan-dates">Start &amp; end dates</a>
    <a href="#ramadan-dawn">Suhoor &amp; Iftar</a>
    <a href="#ramadan-example">Worked example</a>
   </nav>}
   {slug==='ramadan-countdown'&&<nav class="three-tool-nav three-tool-shortcuts" aria-label="Ramadan Countdown quick links"><a href="#countdown-calculator">Live countdown</a><a href="#countdown-meaning">Sunset or midnight?</a><a href="#countdown-example">Worked example</a><a href="#countdown-sources">Sources</a></nav>}
   {slug==='laylatul-qadr-nights'&&<nav class="three-tool-nav three-tool-shortcuts" aria-label="Laylatul Qadr quick links"><a href="#qadr-calculator">Plan the last ten</a><a href="#qadr-count">29 vs 30 nights</a><a href="#qadr-dua">Authentic dua</a><a href="#qadr-sources">Sources</a></nav>}
   {slug==='white-days-calendar'&&<nav class="three-tool-nav three-tool-shortcuts" aria-label="White Days quick links"><a href="#white-calculator">See upcoming dates</a><a href="#white-exceptions">Fasting exceptions</a><a href="#white-example">Worked example</a><a href="#white-sources">Sources</a></nav>}
   {slug==='fasting-tracker'&&<nav class="three-tool-nav three-tool-shortcuts" aria-label="Fasting Tracker quick links"><a href="#fasting-history-calculator">Record fasts</a><a href="#fasting-history-qada">Qada explanation</a><a href="#fasting-history-example">Worked example</a><a href="#fasting-history-sources">Sources</a></nav>}
   {slug==='fidya-calculator'&&<nav class="three-tool-nav three-tool-shortcuts" aria-label="Fidya quick links"><a href="#fidya-calculator-panel">Calculate Fidya</a><a href="#fidya-who">Who qualifies?</a><a href="#fidya-example">Worked example</a><a href="#fidya-sources">Sources</a></nav>}
   {slug==='kaffarah-calculator'&&<nav class="three-tool-nav three-tool-shortcuts" aria-label="Kaffarah quick links"><a href="#kaffarah-calculator-panel">Compare cases</a><a href="#kaffarah-oaths">Oath remedies</a><a href="#kaffarah-ramadan">Ramadan remedies</a><a href="#kaffarah-sources">Sources</a></nav>}
   {slug==='fitrana-calculator'&&<nav class="three-tool-nav three-tool-shortcuts" aria-label="Fitrana quick links"><a href="#fitrana-deep-calculator">Calculate Fitrana</a><a href="#fitrana-people">Household</a><a href="#fitrana-example">Worked example</a><a href="#fitrana-sources">Sources</a></nav>}
   {slug==='gold-zakat-calculator'&&<nav class="three-tool-nav three-tool-shortcuts" aria-label="Gold Zakat quick links"><a href="#gold-deep-calculator">Value gold</a><a href="#gold-purity">Purity</a><a href="#gold-example">Worked example</a><a href="#gold-sources">Sources</a></nav>}
