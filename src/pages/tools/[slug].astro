<script>
 import {enhanceToolKnowledge} from '../../scripts/toolAccordion.js';
 enhanceToolKnowledge(document);
 const todayDate=document.querySelector<HTMLElement>('#today-hijri-value');
 const todayNote=document.querySelector<HTMLElement>('#today-hijri-note');
 if(todayDate){try{
  const formatter=new Intl.DateTimeFormat('en-GB-u-ca-islamic-umalqura',{day:'numeric',month:'long',year:'numeric'});
  const formatted=formatter.format(new Date());
  todayDate.textContent=(/\bAH\b/i.test(formatted)?formatted:formatted+' AH')+' (calculated)';
  if(todayNote)todayNote.textContent="The date is calculated using Umm al-Qura. Local moon sighting and sunset may give a different date.";
 }catch{todayDate.textContent='Use the date converter to check the current Hijri date.'}}
 const share=document.querySelector<HTMLButtonElement>('#share-current-tool');
 const feedback=document.querySelector<HTMLElement>('#share-feedback');
 const slug=window.location.pathname.split('/').filter(Boolean).pop()??'';
 share?.addEventListener('click',async()=>{const url=window.location.href;try{if(navigator.share){await navigator.share({title:document.title,url});if(feedback)feedback.textContent='Sharing options opened'}else if(navigator.clipboard){await navigator.clipboard.writeText(url);if(feedback)feedback.textContent='Link copied';share.textContent='✓ Copied'}else{if(feedback)feedback.textContent='Copy the URL from your browser address bar'}}catch(e){if(feedback)feedback.textContent='Share cancelled or unavailable'}});
 try{const recentKey='sunnah-recent-tools-v1';const recents=JSON.parse(localStorage.getItem(recentKey)??'[]');const safe=Array.isArray(recents)?recents.filter((s:unknown)=>typeof s==='string'&&s!==slug) as string[]:[];localStorage.setItem(recentKey,JSON.stringify([slug,...safe].slice(0,4)))}catch{}
</script>
