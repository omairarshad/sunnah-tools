---
import Base from '../../layouts/Base.astro';
import ToolApp from '../../components/ToolApp';
import {tools,toolBySlug} from '../../data/tools';
import {guides} from '../../data/guides';
export function getStaticPaths(){return tools.map(tool=>({params:{slug:tool.slug}}))}
const slug=Astro.params.slug as keyof typeof toolBySlug;
const tool=toolBySlug[slug];
const guide=guides[slug];
const related=tools.filter(x=>x.slug!==slug).sort((a,b)=>Number(b.category===tool.category)-Number(a.category===tool.category)).slice(0,4);
const breadcrumb={'@context':'https://schema.org','@type':'BreadcrumbList','itemListElement':[{'@type':'ListItem',position:1,name:'Home',item:'https://sunnah.tools/'},{'@type':'ListItem',position:2,name:tool.name,item:`https://sunnah.tools/tools/${slug}/`}]};
---
<Base title={tool.name} description={tool.desc}>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)}/>
 <section class="tool">
  <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">All Islamic tools</a><span aria-hidden="true"> / </span>{tool.name}</nav>
  <p class="eyebrow">{tool.category.toUpperCase()} · FREE TOOL</p>
  <h1>{tool.name}</h1><p class="tool-lead">{guide.intro}</p>
  <div class="tool-inner"><ToolApp slug={slug} client:only="react"/></div>
  <section class="explainer" aria-labelledby="how-it-works"><h2 id="how-it-works">How this tool works</h2><p>{guide.method}</p>{guide.source&&<p class="small">Reference: <a href={guide.source.url} target="_blank" rel="noopener noreferrer">{guide.source.label}</a>.</p>}</section>
  <section class="explainer" aria-labelledby="faq"><h2 id="faq">Common question</h2><details><summary>{guide.question}</summary><p>{guide.answer}</p></details></section>
  <p class="warn">Sunnah Tools provides informational calculations, not binding religious rulings. Dates and methods vary by region and practice. Confirm important worship decisions with trusted local guidance.</p>
  <section class="related"><h2>More free Islamic tools</h2><div class="related-links">{related.map(other=><a href={`/tools/${other.slug}/`}>{other.name} <span aria-hidden="true">↗</span></a>)}</div></section>
 </section>
</Base>