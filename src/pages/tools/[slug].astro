---
import Base from '../../layouts/Base.astro';
import ToolApp from '../../components/ToolApp';
const names={
'prayer-times':['Prayer Times','Calculate worldwide daily prayer times.'],'qibla-finder':['Qibla Finder','Find the true-north direction to Makkah.'],'tahajjud-time':['Tahajjud Calculator','Find the beginning of the final third of night.'],'ramadan-timetable':['Ramadan Timetable','Print a 30-day Fajr and Maghrib schedule.'],'zakat-calculator':['Zakat Calculator','Estimate Zakat with your own asset and Nisab figures.'],'hijri-converter':['Hijri Date Converter','Convert a Gregorian date to the Umm al-Qura calendar.'],'islamic-age':['Islamic Age Calculator','Find your approximate completed Hijri years.'],'tasbih-counter':['Tasbih Counter','Keep a local digital dhikr count.'],'quran-planner':['Quran Reading Planner','Break a Quran reading goal into daily pages.']
} as const;
export function getStaticPaths(){return Object.keys(names).map(slug=>({params:{slug}}))}
const slug=Astro.params.slug as keyof typeof names;
const [name,description]=names[slug];
---
<Base title={name} description={description}><section class="tool"><p class="eyebrow"><a href="/">← All Islamic tools</a></p><h1>{name}</h1><p>{description}</p><div class="tool-inner"><ToolApp slug={slug} client:only="react"/></div><p class="warn">Sunnah Tools is an educational utility, not a religious authority. Calculation conventions may differ. Confirm important worship decisions with trusted qualified sources and your local mosque.</p><a href="/">Explore more tools →</a></section></Base>