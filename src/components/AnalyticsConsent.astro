---
import {siteAnalytics} from '../lib/siteAnalytics';
const active=siteAnalytics.enabled;
const measurementId=siteAnalytics.id;
---
{active&&<div id="analytics-consent" class="analytics-consent" hidden role="region" aria-label="Optional analytics preferences">
 <div><strong>Optional site analytics</strong><p>May we use Google Analytics to measure visits and understand which tools people use? No analytics script loads unless you allow it. We never send your calculation inputs or entered locations. See our <a href="/privacy/">privacy policy</a>.</p></div>
 <div class="consent-actions"><button type="button" id="analytics-no">No thanks</button><button type="button" id="analytics-yes">Allow analytics</button></div>
</div>}
{active&&<script define:vars={{measurementId}} is:inline>
(function(){
 const key='sunnah-analytics-choice-v1';
 const notice=document.getElementById('analytics-consent');
 const launcher=document.getElementById('analytics-preferences');
 let choice=null,loaded=false,searchTracked=false;
 try{choice=localStorage.getItem(key)}catch{}
 window.dataLayer=window.dataLayer||[];
 function gtag(){window.dataLayer.push(arguments);}
 // Basic consent mode v2: set defaults before any external tag can load.
 gtag('consent','default',{
  analytics_storage:'denied',ad_storage:'denied',
  ad_user_data:'denied',ad_personalization:'denied'
 });
 const show=()=>{if(notice)notice.hidden=false;};
 const hide=()=>{if(notice)notice.hidden=true;};
 function loadAnalytics(){
  if(loaded)return;
  loaded=true;
  gtag('consent','update',{
   analytics_storage:'granted',ad_storage:'denied',
   ad_user_data:'denied',ad_personalization:'denied'
  });
  gtag('js',new Date());
  gtag('config',measurementId,{send_page_view:true});
  const tag=document.createElement('script');
  tag.async=true;
  tag.src='https://www.googletagmanager.com/gtag/js?id='+encodeURIComponent(measurementId);
  document.head.append(tag);
 }
 function update(value){
  const hadLoaded=loaded;
  choice=value;
  try{localStorage.setItem(key,value)}catch{}
  hide();
  if(value==='yes')loadAnalytics();
  else if(hadLoaded){
   gtag('consent','update',{analytics_storage:'denied'});
   // Unload the tag entirely; mere consent update may still permit cookieless pings.
   window.location.reload();
  }
 }
 if(choice==='yes')loadAnalytics();
 else if(choice!=='no')show();
 document.getElementById('analytics-yes')?.addEventListener('click',()=>update('yes'));
 document.getElementById('analytics-no')?.addEventListener('click',()=>update('no'));
 launcher?.addEventListener('click',show);
 window.sunnahTrack=function(name,params){
  if(choice!=='yes'||!loaded||!/^([a-z][a-z0-9_]{1,39})$/.test(name))return;
  // Do not pass free-form search queries, coordinates, calculations or input values.
  gtag('event',name,params||{});
 };
 document.addEventListener('click',function(event){
  if(!(event.target instanceof Element))return;
  const promo=event.target.closest('[data-promo-id]');
  if(promo){
   window.sunnahTrack('promotion_click',{promotion_id:promo.getAttribute('data-promo-id')||'unknown'});
   return;
  }
  const tool=event.target.closest('a[href^="/tools/"]');
  if(tool){
   const slug=(tool.getAttribute('href')||'').split('/')[2];
   if(/^[a-z0-9-]{2,64}$/.test(slug||''))window.sunnahTrack('tool_open',{tool_slug:slug});
  }
 });
 document.getElementById('tool-search-input')?.addEventListener('input',function(){
  if(!searchTracked&&this.value.trim().length>=2){
   searchTracked=true;
   window.sunnahTrack('tool_search_used',{});
  }
 });
})();
</script>}
