---
import '../styles/global.css';
import '../styles/premium.css';
import '../styles/tool-cards.css';
import '../styles/dark.css';
import '../styles/typography.css';
import AnalyticsConsent from '../components/AnalyticsConsent.astro';
import {siteAnalytics} from '../lib/siteAnalytics';
import {siteAds} from '../lib/siteAds';
const {title='Free Islamic Tools & Calculators',description='Prayer times, Qibla direction, Zakat, Ramadan calendars and Hijri date tools.',noindex=false}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site);
const home=Astro.url.pathname==='/';
const org={'@context':'https://schema.org','@type':'WebSite',name:'Sunnah Tools',url:'https://sunnah.tools/',description:'Free online Islamic calculators, prayer times, Qibla tools, and planners.'};
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<script is:inline>
 (() => {
  let stored = null;
  try { stored = localStorage.getItem('sunnah-tools-theme'); } catch {}
  const prefersDark = window.matchMedia?.('(prefers-color-scheme: dark)').matches ?? false;
  document.documentElement.dataset.theme = stored === 'dark' || stored === 'light' ? stored : (prefersDark ? 'dark' : 'light');
 })();
</script>
<script is:inline>
 (() => {
  // Voluntary session-only font experiment; normal visitors use the existing design.
  const fonts={
   'petrona-karla':'https://fonts.googleapis.com/css2?family=Karla:wght@400;500;600;700;800&family=Petrona:wght@400;500;600;700&display=swap',
   'alegreya-family':'https://fonts.googleapis.com/css2?family=Alegreya:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Alegreya+Sans:wght@400;500;600;700;800&display=swap',
   'eczar-plex':'https://fonts.googleapis.com/css2?family=Eczar:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap'
  };
  const storageKey='sunnah-font-preview';
  const selected=new URLSearchParams(location.search).get('font-preview');
  const allowed=value=>typeof value==='string'&&Object.prototype.hasOwnProperty.call(fonts,value);
  let choice='';
  try {
   if(selected==='off')sessionStorage.removeItem(storageKey);
   else if(allowed(selected))sessionStorage.setItem(storageKey,selected);
   choice=sessionStorage.getItem(storageKey)||'';
  } catch {if(allowed(selected))choice=selected}
  if(!allowed(choice))return;
  document.documentElement.dataset.fontPreview=choice;
  const fontsLink=document.createElement('link');fontsLink.rel='stylesheet';fontsLink.href=fonts[choice];document.head.appendChild(fontsLink);
  const previewLink=document.createElement('link');previewLink.rel='stylesheet';previewLink.href='/font-preview.css';document.head.appendChild(previewLink);
 })();
</script>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Karla:wght@400;500;600;700;800&amp;family=Petrona:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&amp;display=swap"/>
<meta name="description" content={description}/>
{noindex&&<meta name="robots" content="noindex,nofollow"/>}<link rel="canonical" href={canonical.toString()}/>
<meta property="og:type" content="website"/><meta property="og:site_name" content="Sunnah Tools"/><meta property="og:title" content={title+' | Sunnah Tools'}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical.toString()}/>
{siteAds.canVerify&&<meta name="google-adsense-account" content={siteAds.client}/>}
{siteAds.enabled&&<script async src={'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client='+siteAds.client} crossorigin="anonymous"></script>}
<meta name="twitter:card" content="summary"/><link rel="icon" href="/favicon.svg"/><meta name="theme-color" content="#102f28"/>
{home&&<script type="application/ld+json" set:html={JSON.stringify(org)}/>}
<title>{title} | Sunnah Tools</title>
</head>
<body>
<a class="skip-link" href="#content">Skip to content</a>
<header class="site-header">
 <div class="site-header-inner">
  <a class="brand" href="/" aria-label="Sunnah Tools homepage"><img class="brand-symbol" src="/brand-mark.svg" alt="" aria-hidden="true" width="48" height="48" decoding="async"/><span class="brand-wordmark">Sunnah<span class="brand-sub">Tools</span></span></a>
  <nav aria-label="Main navigation" class="top-navigation">
   <a href="/#tools">Explore tools</a>
   <a href="/tools/prayer-times/">Prayer times</a>
   <a href="/tools/zakat-calculator/">Zakat</a>
   <a href="/about/">About</a>
  </nav>
  <div class="header-controls">
   <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch to dark mode" aria-pressed="false" title="Toggle dark mode">
    <svg class="theme-icon theme-icon-moon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.8 13.4A8.8 8.8 0 0 1 10.6 3.2 8.8 8.8 0 1 0 20.8 13.4Z"/></svg>
    <svg class="theme-icon theme-icon-sun" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg>
    <span id="theme-toggle-label">Dark mode</span>
   </button>
   <a href="/#tools" class="header-action">All tools <span aria-hidden="true">↗</span></a>
  </div>
 </div>
</header>
<main id="content"><slot/></main>
<footer class="site-footer"><div class="footer-inner">
 <div><a class="footer-brand" href="/"><img src="/brand-mark.svg" alt="" aria-hidden="true" width="33" height="33" loading="lazy"/><span>Sunnah <em>Tools</em></span></a><p>Prayer times, Islamic calendars and calculators.</p></div>
 <div class="footer-links"><a href="/#tools">All tools</a><a href="/about/">About</a><a href="/guides/prayer-time-methods/">Prayer guide</a><a href="/guides/ramadan-dates-and-timetables/">Ramadan guide</a><a href="/privacy/">Privacy</a><a href="/sitemap-index.xml">Sitemap</a></div>
 {siteAnalytics.enabled&&<div class="privacy-controls"><button type="button" id="analytics-preferences">Analytics preferences</button></div>}
 <p class="footer-bottom">© {new Date().getFullYear()} Sunnah Tools. Calculations are informational; follow trusted local guidance for religious decisions.</p>
</div></footer>
<AnalyticsConsent/>
<script>
 const themeButton=document.querySelector<HTMLButtonElement>('#theme-toggle');
 const themeLabel=document.querySelector<HTMLElement>('#theme-toggle-label');
 const themeStorageKey='sunnah-tools-theme';
 const root=document.documentElement;
 const themeMedia=window.matchMedia?.('(prefers-color-scheme: dark)');
 const preferredTheme=(): 'dark'|'light'=>themeMedia?.matches?'dark':'light';
 const activeTheme=(): 'dark'|'light'=>root.dataset.theme==='dark'?'dark':'light';
 function syncThemeUI(){
  const isDark=activeTheme()==='dark';
  if(themeButton){
   themeButton.setAttribute('aria-pressed',String(isDark));
   themeButton.setAttribute('aria-label',isDark?'Switch to light mode':'Switch to dark mode');
   themeButton.title=isDark?'Switch to light mode':'Switch to dark mode';
  }
  if(themeLabel)themeLabel.textContent=isDark?'Light mode':'Dark mode';
  document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')?.setAttribute('content',isDark?'#0d1714':'#102f28');
 }
 themeButton?.addEventListener('click',()=>{
  const next=activeTheme()==='dark'?'light':'dark';
  root.dataset.theme=next;
  try{localStorage.setItem(themeStorageKey,next)}catch{}
  syncThemeUI();
 });
 themeMedia?.addEventListener?.('change',()=>{
  try{if(localStorage.getItem(themeStorageKey)==='dark'||localStorage.getItem(themeStorageKey)==='light')return}catch{}
  root.dataset.theme=preferredTheme();
  syncThemeUI();
 });
 syncThemeUI();
</script>
<script is:inline>
 (() => {
  const choice=document.documentElement.dataset.fontPreview;
  const labels={'petrona-karla':'Petrona + Karla','alegreya-family':'Alegreya + Alegreya Sans','eczar-plex':'Eczar + IBM Plex Sans'};
  if(!Object.prototype.hasOwnProperty.call(labels,choice))return;
  const bar=document.createElement('aside');
  bar.className='font-preview-bar';
  bar.setAttribute('aria-label','Temporary font preview controls');
  const label=document.createElement('span');label.textContent='Font preview: '+labels[choice];
  const compare=document.createElement('a');compare.textContent='Compare all fonts';compare.href='/font-lab/';
  const exit=document.createElement('a');exit.textContent='Exit preview';exit.href='/?font-preview=off';
  bar.append(label,compare,exit);document.body.appendChild(bar);
 })();
</script>
</body>
</html>