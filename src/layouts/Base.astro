---
import '../styles/global.css';
import '../styles/premium.css';
import AnalyticsConsent from '../components/AnalyticsConsent.astro';
import {siteAnalytics} from '../lib/siteAnalytics';
import {siteAds} from '../lib/siteAds';
const {title='Free Islamic Tools & Calculators',description='Free Islamic calculators, prayer times, Qibla direction, Zakat and Hijri date tools — no registration required.',noindex=false}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site);
const home=Astro.url.pathname==='/';
const org={'@context':'https://schema.org','@type':'WebSite',name:'Sunnah Tools',url:'https://sunnah.tools/',description:'Free online Islamic calculators, prayer times, Qibla tools, and planners.'};
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="description" content={description}/>
{noindex&&<meta name="robots" content="noindex,nofollow"/>}<link rel="canonical" href={canonical.toString()}/>
<meta property="og:type" content="website"/><meta property="og:site_name" content="Sunnah Tools"/><meta property="og:title" content={title+' | Sunnah Tools'}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical.toString()}/>
{siteAds.canVerify&&<meta name="google-adsense-account" content={siteAds.client}/>}
{siteAds.enabled&&<script async src={'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client='+siteAds.client} crossorigin="anonymous"></script>}
<meta name="twitter:card" content="summary"/><link rel="icon" href="/favicon.svg"/><meta name="theme-color" content="#102f28"/>
{home&&<script type="application/ld+json" set:html={JSON.stringify(org)}/>}
<title>{title} | Sunnah Tools</title>
</head>
<body>
<a class="skip-link" href="#content">Skip to content</a>
<header class="site-header">
 <div class="site-header-inner">
  <a class="brand" href="/" aria-label="Sunnah Tools homepage"><img class="brand-symbol" src="/brand-mark.svg" alt="" aria-hidden="true" width="48" height="48" decoding="async"/><span class="brand-wordmark">Sunnah<span class="brand-sub">Tools</span></span></a>
  <nav aria-label="Main navigation" class="top-navigation">
   <a href="/#tools">Explore tools</a>
   <a href="/tools/prayer-times/">Prayer times</a>
   <a href="/tools/zakat-calculator/">Zakat</a>
   <a href="/about/">About</a>
  </nav>
  <a href="/#tools" class="header-action">All tools <span aria-hidden="true">↗</span></a>
 </div>
</header>
<main id="content"><slot/></main>
<footer class="site-footer"><div class="footer-inner">
 <div><a class="footer-brand" href="/"><img src="/brand-mark.svg" alt="" aria-hidden="true" width="33" height="33" loading="lazy"/><span>Sunnah <em>Tools</em></span></a><p>Thoughtful Islamic utilities, free and easy to use.</p></div>
 <div class="footer-links"><a href="/#tools">All tools</a><a href="/about/">About</a><a href="/guides/prayer-time-methods/">Prayer guide</a><a href="/guides/ramadan-dates-and-timetables/">Ramadan guide</a><a href="/privacy/">Privacy</a><a href="/admin/">Site dashboard</a><a href="/sitemap-index.xml">Sitemap</a></div>
 {siteAnalytics.enabled&&<div class="privacy-controls"><button type="button" id="analytics-preferences">Analytics preferences</button></div>}
 <p class="footer-bottom">© {new Date().getFullYear()} Sunnah Tools. Calculations are informational; follow trusted local guidance for religious decisions.</p>
</div></footer>
<AnalyticsConsent/>
</body>
</html>