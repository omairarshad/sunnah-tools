# Sunnah Tools: avoid serving stale HTML after a Hostinger GitHub deployment.
# Applies to Apache/LiteSpeed only; Nginx hosting requires equivalent Hostinger cache rules.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm|xml|json)$">
    Header always set Cache-Control "no-cache, must-revalidate"
    Header always set X-Content-Type-Options "nosniff"
  </FilesMatch>
  <FilesMatch "^release\.json$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>
